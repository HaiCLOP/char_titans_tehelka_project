# Copy to .env.local and fill in. NEVER commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://fszfozblvqtpoobmougu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=
# Any random string, 32+ chars (encrypts API keys stored in the DB)
AI_KEYS_SECRET=
# Comma-separated Gemini keys (bootstrap; later managed in the system panel)
GEMINI_API_KEYS=
# Comma-separated OpenRouter keys — FREE models only (router refuses paid ones)
OPENROUTER_API_KEYS=
# Secret path segment for the system panel, e.g. sys-7f3a9c
SYS_PANEL_PATH=
# Comma-separated emails allowed into the system panel
SYS_PANEL_EMAILS=
# Optional. Public base URL used for auth redirects (magic link / Google), e.g. https://civicsense.vercel.app
# Falls back to the browser origin. Add <URL>/auth/callback to Supabase Auth → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=
